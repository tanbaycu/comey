{
  "name": "comey-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @comey/core build && pnpm --filter @comey/apps-script build && pnpm --filter @comey/dashboard build && pnpm --filter @comey/cloud build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node scripts/dev.mjs",
    "dev:cloud": "pnpm --filter @comey/cloud dev",
    "dev:dashboard": "pnpm --filter @comey/dashboard dev"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  }
}
